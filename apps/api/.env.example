# Copy this file to `.env` and fill in your real MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3001
# For production (e.g., Render.com), set to your deployed URL
# BACKEND_URL=https://your-app.onrender.com
# Card recommendation API (mtgit recsys, `docker compose up -d` there)
RECSYS_API_URL=http://127.0.0.1:5000
