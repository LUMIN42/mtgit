{
  "name": "mtgit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "npm run dev --workspace @mtgit/api",
    "dev:frontend": "npm run dev --workspace @mtgit/frontend",
    "build": "npm run build --workspace @mtgit/shared && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^10.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "madge": "^8.0.0"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "eslint-plugin-react": "^7.37.5",
    "jiti": "^2.6.1"
  }
}
